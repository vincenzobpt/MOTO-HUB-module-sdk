<?xml version="1.0" encoding="utf-8"?>
<!--
  The module runs inside the app's process and never merges a manifest of its own: the
  permission below is the app's to hold. It is declared here so the module says what its
  code needs - AaSelfMode reads ConnectivityManager.activeNetwork - and lint can check the
  module on its own instead of failing every root lintRelease with MissingPermission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
