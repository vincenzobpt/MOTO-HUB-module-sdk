<?xml version="1.0" encoding="utf-8"?>
<!--
  The module runs inside the app's process and never merges a manifest of its own: these
  permissions are the app's to hold. They are declared here so the module says what its code
  needs - it joins the camera's access point with a WifiNetworkSpecifier and reads the
  network's routes - and lint can check the module on its own.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
